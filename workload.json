{
  "schemaVersion": 1,
  "id": "platform-status-web",
  "applicationType": "container",
  "networks": [
    {"name": "database", "internetAccess": true},
    {"name": "public-proxy", "internetAccess": true}
  ],
  "services": [
    {
      "name": "platform-status-service",
      "image": "acr7ca0fd3326df.azurecr.io/workloads/platform-status-web/service@sha256:176d71ce6a68685ab0c9ec6dd2f36173c69c5b1c4ad18463a957c58234aeba9e",
      "runAs": "10001:10001",
      "environment": {
        "STATUS_RUNTIME_FILE": "/node/runtime.json"
      },
      "networks": ["database", "public-proxy"],
      "mounts": [
        {"id": "publications", "target": "/data", "readOnly": false},
        {"id": "configuration", "target": "/node", "readOnly": true}
      ],
      "secrets": [
        {"id": "monitoring-reader-certificate", "target": "monitoring-reader-certificate"},
        {"id": "github-incidents-private-key", "target": "github-incidents-private-key"},
        {"id": "app-password", "target": "app-password"},
        {"id": "traffic-configuration", "target": "traffic-configuration"},
        {"id": "traffic-api-token", "target": "traffic-api-token"}
      ],
      "tmpfs": ["/tmp"],
      "resources": {"cpus": 0.5, "memoryMb": 512, "pids": 128},
      "health": {
        "test": ["CMD", "dotnet", "MX.Platform.Status.Service.dll", "--healthcheck"],
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "retries": 3,
        "startPeriodSeconds": 30
      }
    },
    {
      "name": "platform-status-postgres",
      "image": "acr7ca0fd3326df.azurecr.io/workloads/platform-status-web/postgres@sha256:fa036c6ec207ecfc522ab5169ddfe2ce0ce6ac308f628a4e0fe9cfd0f9eb7a0d",
      "runAs": "999:10001",
      "networks": ["database"],
      "mounts": [
        {"id": "postgres", "target": "/var/lib/postgresql/data", "readOnly": false},
        {"id": "configuration", "target": "/node", "readOnly": true}
      ],
      "secrets": [
        {"id": "postgres-password", "target": "postgres-password"},
        {"id": "app-password", "target": "app-password"},
        {"id": "replication-password", "target": "replication-password"}
      ],
      "tmpfs": ["/tmp"],
      "resources": {"cpus": 0.5, "memoryMb": 512, "pids": 128},
      "health": {
        "test": ["CMD", "pg_isready", "--host=127.0.0.1", "--username=status_app", "--dbname=status"],
        "intervalSeconds": 10,
        "timeoutSeconds": 5,
        "retries": 6,
        "startPeriodSeconds": 60
      }
    }
  ],
  "ingress": [
    {
      "scope": "tailscale",
      "hostname": "status-database.mxstatus.io",
      "service": "platform-status-postgres",
      "containerPort": 5432
    }
  ],
  "deployment": {
    "healthTimeoutSeconds": 300,
    "healthPollSeconds": 3,
    "rollbackOnFailure": true
  }
}
