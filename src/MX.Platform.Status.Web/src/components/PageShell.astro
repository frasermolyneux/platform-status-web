---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'System status and incident history.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <link rel="stylesheet" href="/styles/github-minimal.css" />
</head>
<body>
  <a class="skip-link" href="#app">Skip to status</a>
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/" aria-label="Status overview">
        <span class="brand-mark" aria-hidden="true">S</span>
        <span>
          <h1 class="site-title" id="site-title">Status</h1>
          <p class="site-tagline" id="site-tagline">Service availability &amp; incident updates</p>
        </span>
      </a>
      <nav class="site-nav" aria-label="Status navigation">
        <a href="/">Current status</a>
        <a href="/history">History</a>
        <a href="/feed.xml">Subscribe via RSS</a>
        <a href="/ops" class="operator-link">Operations</a>
      </nav>
    </div>
  </header>
  <main class="container" id="app" tabindex="-1">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>Transparent updates. Independent infrastructure.</p>
      <p>&copy; {new Date().getFullYear()} &middot; <a href="https://github.com/frasermolyneux/platform-status-web">Platform status</a></p>
    </div>
  </footer>
</body>
</html>
