root = true

[*.cs]
# SonarAnalyzer.CSharp is injected by the SonarCloud "dotnet-sonarscanner begin" step in CI
# (frasermolyneux/actions/.github/workflows/codequality.yml), which runs before the
# "dotnet format --verify-no-changes" formatting check. `dotnet format` auto-fixes any
# analyzer diagnostic at "warning" severity or above that ships a code fix provider, so a
# Sonar suggestion can unexpectedly fail the format gate even though it never fails the
# SonarCloud quality gate itself.
#
# S2325 ("Make 'X' a static method") flags service methods on classes that are
# intentionally kept instance-scoped for DI/testability (see MX.Platform.Status.App
# Telemetry/ComponentStatusCalculator.cs, Telemetry/AvailabilityQueryBuilder.cs, and
# Rollup/DailyRollupService.cs). Converting them to static would strip the classes'
# constructor dependencies and their ability to be mocked/substituted in tests, so this
# suggestion is intentionally accepted rather than "fixed" and is downgraded below
# `dotnet format`'s auto-fix threshold (warning).
dotnet_diagnostic.S2325.severity = suggestion
